# FRESH AI Environment Configuration

# Flask Application Secret Key (Change this in production)
SECRET_KEY=fresh-ai-capstone-secret-key-2026-secure-session

# Server Port
PORT=5000

# Database URL (Default: SQLite local database in backend/database/fresh_ai.db)
DATABASE_URL=sqlite:///database/fresh_ai.db

# Optional GnuPG Custom Executable Path (if not standard in Windows PATH)
# GPG_BINARY_PATH=C:\Program Files (x86)\GnuPG\bin\gpg.exe
